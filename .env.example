# Copy to .env.local and adjust. All values are optional; defaults shown.

# SQLite database file (created automatically). Keep it outside git.
GRACE_DB_PATH=./data/grace.db

# Character Bible source file loaded into the database.
GRACE_CHARACTER_BIBLE_PATH=./characters/grace/bible.json

# ComfyUI local server. ComfyUI Desktop may use port 8000 instead of 8188.
COMFYUI_URL=http://127.0.0.1:8188

# Local LLM provider. Only "lmstudio" is implemented.
LLM_PROVIDER=lmstudio
LMSTUDIO_URL=http://127.0.0.1:1234
# Model identifier as listed by LM Studio (GET /v1/models). Leave empty until chosen.
LMSTUDIO_MODEL=

# Timeout for provider health checks, in milliseconds.
PROVIDER_TIMEOUT_MS=3000

# Runtime settings. These only SEED the settings table on first start; after that the value
# stored in SQLite wins (change it via PATCH /api/settings). Defaults shown.
AUTOPILOT_MODE=ASSISTED
PUBLISH_MODE=MANUAL
# Absolute path. The default is Jatin's Mac; it is not assumed to exist elsewhere.
COMFYUI_OUTPUT_FOLDER=/Users/jatinpal/ComfyUI/output/

# Safety lock. FULL autopilot and AUTOMATIC publishing are rejected unless this is true.
# Must stay false during development.
ALLOW_FULL_AUTOPILOT=false
